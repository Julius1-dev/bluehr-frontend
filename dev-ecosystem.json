{
  "apps": [
    {
      "name": "bluehr-frontend-v2",
      "cwd": "/var/www/blue--hr/bluehr-frontend-v2",
      "script": "npm",
      "args": "run start",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3012"
      },
      "env_file": ".env",
      "log_file": "/root/.pm2/logs/bluehr-frontend-v2-combined.log",
      "error_file": "/root/.pm2/logs/bluehr-frontend-v2-err.log",
      "out_file": "/root/.pm2/logs/bluehr-frontend-v2-out.log",
      "merge_logs": false,
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "instances": "1",
      "exec_mode": "fork",
      "autorestart": true,
      "restart_delay": 5000,
      "max_restarts": 10,
      "min_uptime": "30s",
      "max_memory_restart": "500M"
    }
  ]
}